{
  "name": "rahe/simple-image-sizes",
  "description": "Add options on the Media settings page for image sizes",
  "minimum-stability": "stable",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Nicolas Juen",
      "email": "njuen87@gmail.com"
    }
  ],
  "type": "wordpress-plugin",
  "require": {
    "php": ">=8.0"
  },
  "autoload": {
    "psr-4": {
      "Rahe\\Simple_Image_Sizes\\": "classes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Rahe\\Simple_Image_Sizes\\Tests\\": "tests/php/"
    }
  },
  "scripts": {
    "cb": "./vendor/bin/phpcbf ./",
    "cs": "./vendor/bin/phpcs ./",
    "lint": "./vendor/bin/parallel-lint --exclude vendor .",
    "test": "./vendor/bin/phpunit"
  },
  "scripts-descriptions": {
    "cb": "Fix PHP coding standards violations.",
    "cs": "Check PHP coding standards.",
    "lint": "Check PHP syntax.",
    "test": "Run the PHP unit test suite."
  },
  "config": {
    "platform": {
      "php": "8.0.0"
    },
    "allow-plugins": {
      "phpro/grumphp-shim": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "php-parallel-lint/php-parallel-lint": "^1.4",
    "phpcompatibility/php-compatibility": "^9.3",
    "phpro/grumphp-shim": "^2.0",
    "wp-coding-standards/wpcs": "^3.1",
    "wp-phpunit/wp-phpunit": "^6.7",
    "yoast/phpunit-polyfills": "^1.0"
  }
}
